            = (-u_xlat16) * 0.5 + u_xlat7.x;\n    u_xlat16 = (-u_xlat16) * 0.5 +
            0.5;\n    vs_TEXCOORD1.z = u_xlat2.x + u_xlat16;\n    u_xlat2 = max(_ClipRect,
            vec4(-2e+10, -2e+10, -2e+10, -2e+10));\n    u_xlat2 = min(u_xlat2, vec4(2e+10,
