            float u_xlat16_4;\nmediump float u_xlat16_7;\nmediump float u_xlat16_10;\nvoid
            main()\n{\n    u_xlatb0 = 0.0>=_InvertDissolveTex;\n    u_xlat16_3 =
            texture(_DissolveTex, vs_TEXCOORD0.xy).x;\n    u_xlat16_1 = (-u_xlat16_3)
