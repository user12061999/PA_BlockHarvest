            u_xlat6;\nfloat u_xlat9;\nbool u_xlatb9;\nvoid main()\n{\n    vs_COLOR0
            = in_COLOR0;\n    vs_TEXCOORD1 = in_TEXCOORD0.xyxy;\n    vs_TEXCOORD2.xzw
            = in_TEXCOORD1.xzw;\n    vs_TEXCOORD2.y = 0.5;\n    u_xlat0.x = dot(in_NORMAL0.xyz,
