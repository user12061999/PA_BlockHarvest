            vs_TEXCOORD2.xy);\n    u_xlat1.xy = u_xlat16_1.xy;\n    u_xlat13.xy =
            (-u_xlat1.xy);\n    u_xlat3.xy = u_xlat13.xy + u_xlat3.xy;\n    u_xlat13.xy
            = vs_TEXCOORD2.zw;\n    u_xlat3.xy = u_xlat13.xy * u_xlat3.xy;\n    u_xlat3.xy
            = max(u_xlat3.xy, vec2(0.0, 0.0));\n    u_xlat3.xy = min(u_xlat3.xy,
            vec2(1.0, 1.0));\n    u_xlat16_3.xy = u_xlat3.xy;\n    u_xlat16_2.x =
            u_xlat16_3.y * u_xlat16_3.x;\n    u_xlat16_0 = u_xlat16_0 * u_xlat16_2.xxxx;\n   
