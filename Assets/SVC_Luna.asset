            layout(std140)\n#endif\nuniform \tvec4 _Time;\nuniform \tvec4 _BaseColor;\nuniform
            \tvec4 _RippleColor;\nuniform \tfloat _RippleSpeed;\nuniform \tfloat
            _Ripple1SpeedX;\nuniform \tfloat _Ripple1SpeedY;\nuniform \tfloat _Ripple2SpeedX;\nuniform
            \tfloat _Ripple2SpeedY;\nUNITY_LOCATION(0) uniform mediump sampler2D
            _Ripple1Tex;\nUNITY_LOCATION(1) uniform mediump sampler2D _Ripple2Tex;\nin
