            u_xlat7;\nvec2 u_xlat10;\nfloat u_xlat12;\nfloat u_xlat16;\nbool u_xlatb16;\nvoid
            main()\n{\n    u_xlat0.xy = in_POSITION0.xy + vec2(_VertexOffsetX, _VertexOffsetY);\n   
