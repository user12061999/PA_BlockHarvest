            vs_TEXCOORD3;\nlayout(location = 0) out mediump vec4 SV_Target0;\nmediump
            vec3 u_xlat16_0;\nmediump vec3 u_xlat16_1;\nbool u_xlatb2;\nmediump vec3
            u_xlat16_3;\nvoid main()\n{\n    u_xlat16_0.xyz = vs_TEXCOORD0.xyz +
