            * vec2(_Ripple1SpeedX, _Ripple1SpeedY);\n    u_xlat0.xy = u_xlat0.xy
            * vec2(_RippleSpeed) + vs_TEXCOORD0.xy;\n    u_xlat16_0 = texture(_Ripple1Tex,
            u_xlat0.xy).w;\n    u_xlat3 = _RippleColor.w * _RippleColor.w;\n    u_xlat0.x
            = u_xlat16_0 * u_xlat3;\n    u_xlat0.x = u_xlat0.x * vs_COLOR0.w;\n   
            u_xlat1 = vs_COLOR0 * _BaseColor;\n    u_xlat16_2.xyz = u_xlat1.www *
            u_xlat1.xyz;\n    u_xlat2.xyz = (-u_xlat16_2.xyz);\n    u_xlat2.w = (-u_xlat1.w);\n   
            u_xlat2 = u_xlat2 + _RippleColor;\n    u_xlat2 = u_xlat0.xxxx * u_xlat2;\n   
            u_xlat1.xyz = u_xlat1.xyz * u_xlat1.www + u_xlat2.xyz;\n    u_xlat1.w
            = _BaseColor.w * vs_COLOR0.w + u_xlat2.w;\n    u_xlat2 = (-u_xlat1) +
            _RippleColor;\n    u_xlat0.xz = _Time.xx * vec2(_Ripple2SpeedX, _Ripple2SpeedY);\n   
            u_xlat0.xz = u_xlat0.xz * vec2(_RippleSpeed) + vs_TEXCOORD2.xy;\n   
            u_xlat16_0 = texture(_Ripple2Tex, u_xlat0.xz).w;\n    u_xlat0.x = u_xlat16_0
            * u_xlat3;\n    u_xlat0.x = u_xlat0.x * vs_COLOR0.w;\n    u_xlat0 = u_xlat0.xxxx
            * u_xlat2 + u_xlat1;\n    SV_Target0 = u_xlat0;\n    return;\n}\n\n"
