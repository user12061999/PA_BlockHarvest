            + _WeightBold;\n    u_xlat16 = u_xlat16 * u_xlat2.x + _WeightNormal;\n   
            u_xlat16 = u_xlat16 * 0.25 + _FaceDilate;\n    u_xlat16 = u_xlat16 *
            _ScaleRatioA;\n    u_xlat7.z = u_xlat16 * 0.5;\n    vs_TEXCOORD1.yw =
