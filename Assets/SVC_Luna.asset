            * vec4(1.0, 1.0, 1.0, 1.0);\n    u_xlat3 = u_xlat3 + u_xlat4;\n    u_xlat4
            = u_xlat3.xxxx * hlslcc_mtx4x4unity_MatrixVP[0];\n    u_xlat5 = u_xlat3.yyyy
