            layout(std140)\n#endif\nuniform \tmediump float _InvertDissolveTex;\nuniform
            \tmediump float _DoubleDissolve;\nuniform \tmediump float _DissolveSmooth;\nuniform
            \tfloat _ShadowStrength;\nUNITY_LOCATION(0) uniform mediump sampler2D
            _MainTex;\nUNITY_LOCATION(1) uniform mediump sampler2D _DissolveTex;\nUNITY_LOCATION(2)
            uniform mediump sampler3D _DitherMaskLOD;\nin mediump  vec4 vs_COLOR0;\nin
            highp  vec4 vs_TEXCOORD1;\nin highp  vec4 vs_TEXCOORD2;\nlayout(location
            = 0) out highp vec4 SV_Target0;\nfloat u_xlat0;\nmediump float u_xlat16_0;\nbool
            u_xlatb0;\nvec3 u_xlat1;\nmediump float u_xlat16_1;\nmediump float u_xlat16_2;\nmediump
            float u_xlat16_3;\nmediump float u_xlat16_4;\nmediump float u_xlat16_7;\nmediump
            float u_xlat16_10;\nvoid main()\n{\nvec4 hlslcc_FragCoord = vec4(gl_FragCoord.xyz,
            1.0/gl_FragCoord.w);\n    u_xlatb0 = 0.0>=_InvertDissolveTex;\n    u_xlat16_3
            = texture(_DissolveTex, vs_TEXCOORD1.xy).x;\n    u_xlat16_1 = (-u_xlat16_3)
            + 1.0;\n    u_xlat16_1 = (u_xlatb0) ? u_xlat16_1 : u_xlat16_3;\n    u_xlat16_4
            = u_xlat16_1 + _DissolveSmooth;\n    u_xlat16_1 = u_xlat16_1 + (-_DissolveSmooth);\n   
