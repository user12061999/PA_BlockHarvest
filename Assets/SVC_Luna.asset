            * _ScaleRatioA + 1.0;\n    u_xlat12 = (-_OutlineSoftness) * _ScaleRatioA
            + u_xlat12;\n    u_xlat12 = u_xlat12 * 0.5 + (-u_xlat2.x);\n    vs_TEXCOORD1.x
            = (-u_xlat16) * 0.5 + u_xlat12;\n    u_xlat16 = (-u_xlat16) * 0.5 + 0.5;\n   
            vs_TEXCOORD1.z = u_xlat2.x + u_xlat16;\n    u_xlat3 = max(_ClipRect,
            vec4(-2e+10, -2e+10, -2e+10, -2e+10));\n    u_xlat3 = min(u_xlat3, vec4(2e+10,
            2e+10, 2e+10, 2e+10));\n    u_xlat0.xy = u_xlat0.xy * vec2(2.0, 2.0)
            + (-u_xlat3.xy);\n    vs_TEXCOORD2.xy = (-u_xlat3.zw) + u_xlat0.xy;\n   
            u_xlat0.xy = max(vec2(_MaskSoftnessX, _MaskSoftnessY), vec2(_UIMaskSoftnessX,
            _UIMaskSoftnessY));\n    u_xlat0.xy = u_xlat0.xy * vec2(0.25, 0.25) +
            u_xlat10.xy;\n    vs_TEXCOORD2.zw = vec2(0.25, 0.25) / u_xlat0.xy;\n   
            u_xlat0.xyz = u_xlat1.yyy * hlslcc_mtx4x4_EnvMatrix[1].xyz;\n    u_xlat0.xyz
            = hlslcc_mtx4x4_EnvMatrix[0].xyz * u_xlat1.xxx + u_xlat0.xyz;\n    vs_TEXCOORD3.xyz
            = hlslcc_mtx4x4_EnvMatrix[2].xyz * u_xlat1.zzz + u_xlat0.xyz;\n    u_xlat0
            = vec4(_UnderlaySoftness, _UnderlayDilate, _UnderlayOffsetX, _UnderlayOffsetY)
            * vec4(vec4(_ScaleRatioC, _ScaleRatioC, _ScaleRatioC, _ScaleRatioC));\n   
            u_xlat0.x = u_xlat0.x * u_xlat7.x + 1.0;\n    u_xlat0.x = u_xlat7.x /
            u_xlat0.x;\n    u_xlat1.x = u_xlat16 * u_xlat0.x + -0.5;\n    u_xlat5
            = u_xlat0.x * u_xlat0.y;\n    u_xlat10.xy = (-u_xlat0.zw) * vec2(_GradientScale);\n   
            u_xlat10.xy = u_xlat10.xy / vec2(_TextureWidth, _TextureHeight);\n   
            vs_TEXCOORD4.xy = u_xlat10.xy + in_TEXCOORD0.xy;\n    vs_TEXCOORD4.z
            = u_xlat0.x;\n    vs_TEXCOORD4.w = (-u_xlat5) * 0.5 + u_xlat1.x;\n   
            u_xlat0.xyz = _UnderlayColor.www * _UnderlayColor.xyz;\n    vs_COLOR1.xyz
            = u_xlat0.xyz;\n    vs_COLOR1.w = _UnderlayColor.w;\n    vs_TEXCOORD5.xy
