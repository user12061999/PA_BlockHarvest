            _UIMaskSoftnessY));\n    u_xlat0.xy = u_xlat0.xy * vec2(0.25, 0.25) +
            u_xlat10.xy;\n    vs_TEXCOORD2.zw = vec2(0.25, 0.25) / u_xlat0.xy;\n   
