            = u_xlat11.xy * u_xlat3.xy;\n    u_xlat3.xy = max(u_xlat3.xy, vec2(0.0,
            0.0));\n    u_xlat3.xy = min(u_xlat3.xy, vec2(1.0, 1.0));\n    u_xlat16_3.xy
            = u_xlat3.xy;\n    u_xlat16_2.x = u_xlat16_3.y * u_xlat16_3.x;\n    u_xlat16_0
