            * u_xlat22.xxx;\n        u_xlat1.x = dot(u_xlat4.xyz, u_xlat1.xyw);\n       
            u_xlat11 = (-u_xlat1.x);\n        u_xlat1.x = max(u_xlat11, u_xlat1.x);\n       
