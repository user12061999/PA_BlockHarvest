            / u_xlat16_4;\n    u_xlat16_7 = _DissolveSmooth * 2.0 + 1.0;\n    u_xlat16_7
            = vs_TEXCOORD1.x * u_xlat16_7 + (-_DissolveSmooth);\n    u_xlat16_10
            = (-u_xlat16_1) + u_xlat16_7;\n    u_xlat16_10 = u_xlat16_4 * u_xlat16_10;\n   
